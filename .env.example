# MineSafe Rover Web Dashboard Configuration
# Base URL for AWS-hosted backend REST API endpoints:
# POST /api/sensor-data
# GET /api/latest
# GET /api/history
# GET /api/devices
# GET /api/alerts
# GET /api/analytics
VITE_API_BASE_URL=https://api.minesafe-rover.sih26025.internal

# Polling interval in milliseconds (default: 5000ms = 5s)
VITE_POLL_INTERVAL_MS=5000

# Connection stale timeout in seconds (default: 15s)
VITE_STALE_TIMEOUT_SEC=15

# Default active device ID
VITE_DEFAULT_ROVER_ID=ROVER_01
